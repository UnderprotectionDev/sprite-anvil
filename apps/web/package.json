{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b ../../packages/api && vite build",
    "check-types": "tsc -b ../../packages/api && vite build && tsc --noEmit",
    "desktop:build": "tauri build",
    "desktop:dev": "tauri dev",
    "desktop:test": "wdio run wdio.conf.ts",
    "desktop:test:animation-timing": "wdio run wdio.conf.ts --spec desktop-e2e/animation-timing-reviews.spec.ts",
    "desktop:test:asset-family-comparison": "wdio run wdio.conf.ts --spec desktop-e2e/asset-family-comparisons.spec.ts",
    "desktop:test:build": "VITE_WDIO=true tauri build --debug --no-bundle --config src-tauri/tauri.test.conf.json --features webdriver",
    "desktop:test:directional": "wdio run wdio.conf.ts --spec desktop-e2e/directional-reviews.spec.ts",
    "desktop:test:keyboard": "wdio run wdio.conf.ts --spec desktop-e2e/keyboard-accessibility.spec.ts",
    "desktop:test:marketing-usage": "wdio run wdio.conf.ts --spec desktop-e2e/marketing-usage-reviews.spec.ts --mochaOpts.timeout 180000",
    "desktop:test:portrait-review": "wdio run wdio.conf.ts --spec desktop-e2e/portrait-identity-reviews.spec.ts --mochaOpts.timeout 180000",
    "desktop:test:texture-repetition": "wdio run wdio.conf.ts --spec desktop-e2e/texture-repetition-reviews.spec.ts",
    "desktop:test:ui-state-comparison": "wdio run wdio.conf.ts --spec desktop-e2e/ui-state-comparisons.spec.ts",
    "desktop:test:ui-stretch": "wdio run wdio.conf.ts --spec desktop-e2e/ui-stretch-tests.spec.ts",
    "dev": "vite dev",
    "doctor": "npx react-doctor@latest",
    "e2e:install": "playwright install chromium",
    "env:generate": "varlock codegen",
    "serve": "vite preview",
    "start": "vite",
    "tauri": "tauri",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@orpc/client": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@sprite-anvil/api": "workspace:*",
    "@sprite-anvil/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-virtual": "catalog:",
    "@tanstack/store": "^0.11.2",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@varlock/vite-integration": "1.5.6",
    "better-auth": "catalog:",
    "dexie": "^4.4.7",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "pixi.js": "^8.23.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sprite-anvil/config": "workspace:*",
    "@tanstack/react-query-devtools": "^5.108.0",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/router-plugin": "^1.169.0",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.3.0",
    "@wdio/cli": "^9.33.1",
    "@wdio/globals": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "@wdio/tauri-plugin": "^1.5.1",
    "@wdio/tauri-service": "^1.5.1",
    "@wdio/types": "^9.33.1",
    "fflate": "catalog:",
    "jsdom": "^30.1.3",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
