{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-appdata-write-recursive",
    "fs:scope-appdata-recursive",
    "fs:allow-read-file",
    "fs:allow-stat",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "opener:allow-open-path",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-lstat",
    "fs:allow-remove"
  ]
}
