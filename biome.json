{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!**/.context",
      "!**/.next",
      "!**/dist",
      "!**/.turbo",
      "!**/.nx",
      "!**/dev-dist",
      "!**/.zed",
      "!**/.impeccable",
      "!**/.vscode",
      "!**/routeTree.gen.ts",
      "!packages/api/src/export-bundle-verifier-source.ts",
      "!packages/api/test-support/godot-golden-output",
      "!dither.svg",
      "!apps/web/public/logo.svg",
      "!**/src/migrations/**/snapshot.json",
      "!**/test-results",
      "!**/playwright-report",
      "!**/src/env.ts",
      "!**/src-tauri",
      "!**/.nuxt",
      "!bts.jsonc",
      "!**/.expo",
      "!**/.wrangler",
      "!**/.alchemy",
      "!**/.svelte-kit",
      "!**/wrangler.jsonc",
      "!**/.source",
      "!**/convex/_generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "labelComponents": ["Label"],
            "inputComponents": [
              "Checkbox",
              "Input",
              "NativeSelect",
              "Slider",
              "Switch",
              "Textarea"
            ]
          }
        },
        "useSemanticElements": "off"
      },
      "complexity": {
        "noVoid": "off"
      },
      "correctness": {
        "noUnresolvedImports": "off",
        "useImportExtensions": "off",
        "useExhaustiveDependencies": "info"
      },
      "performance": {
        "noBarrelFile": "off",
        "noJsxPropsBind": "off",
        "noNamespaceImport": "off"
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "warn",
          "fix": "safe"
        }
      },
      "style": {
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "useNumberNamespace": "error",
        "noInferrableTypes": "error",
        "noUselessElse": "error"
      },
      "suspicious": {
        "noUnnecessaryConditions": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["packages/db/scripts/**"],
      "linter": {
        "rules": {
          "performance": { "noAwaitInLoops": "off" }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/type-aware",
    "ultracite/biome/react",
    "ultracite/biome/tanstack"
  ],
  "markdown": { "formatter": { "enabled": false } },
  "yaml": { "formatter": { "enabled": false } },
  "tailwind": { "mergeFunctions": ["clsx", "cn"], "variantFunctions": ["cva"] }
}
