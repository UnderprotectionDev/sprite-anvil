# @import(../../apps/server/, pick=[NODE_ENV, DATABASE_*])
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# Direct Neon connection for schema migrations; app traffic continues to use DATABASE_URL.
# @required=false @type=url
DATABASE_URL_UNPOOLED=

# Trusted direct endpoint hosts identify the allowed Neon migration targets.
# @required=false @type=string(minLength=1)
NEON_DEVELOPMENT_ENDPOINT_HOST=ep-holy-frost-zapt8ycl.c-2.eu-west-2.aws.neon.tech
# @required=false @type=string(minLength=1)
NEON_PRODUCTION_ENDPOINT_HOST=

# Explicit database identities; endpoint spelling alone does not authorize a target.
# @required=false @type=string(minLength=1)
NEON_DEVELOPMENT_DATABASE_NAME=neondb
# @required=false @type=string(minLength=1)
NEON_PRODUCTION_DATABASE_NAME=

# JSON declarations with name, connectionEnv, host and database; never put credentials here.
# @required=false @type=string(minLength=1)
DB_DEVELOPMENT_TARGETS=

# Optional directory containing local PostgreSQL initdb and postgres for source verification.
# @public @required=false @type=string(minLength=1)
DB_POSTGRES_BIN=
