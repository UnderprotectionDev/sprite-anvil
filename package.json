{
  "name": "sprite-anvil",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0",
      "@orpc/server": "^1.15.0",
      "@orpc/openapi": "^1.15.0",
      "@orpc/zod": "^1.15.0",
      "better-auth": "1.7.5",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@orpc/client": "^1.15.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "scripts": {
    "auth:generate": "cd apps/server && bun run auth:generate",
    "build": "turbo run build",
    "build:app": "bun run --cwd apps/web build && bun run --cwd apps/server build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate -F @sprite-anvil/db --",
    "db:migrate": "turbo run db:migrate -F @sprite-anvil/db --",
    "db:push": "turbo run db:push -F @sprite-anvil/db --",
    "db:studio": "turbo run db:studio -F @sprite-anvil/db --",
    "dev": "turbo run dev",
    "dev:server": "turbo run dev -F server --",
    "dev:web": "turbo run dev -F web --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "fix": "ultracite fix",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "prepare": "lefthook install",
    "test": "bun run --cwd apps/web test && bun run --cwd apps/server test",
    "test:e2e": "bun run --cwd apps/web test:e2e"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@sprite-anvil/config": "workspace:*",
    "@types/bun": "catalog:",
    "lefthook": "^2.1.14",
    "railway": "^3.11.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "^7.12.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.3.13"
}
